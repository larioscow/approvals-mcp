{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    // This is an application that integrates the MCP SDK / Express, whose public
    // types predate exactOptionalPropertyTypes. EOPT stays on for the libraries
