# Transport the MCP server listens on: http (remote) or stdio (local)
APPROVALS_TRANSPORT=http
PORT=8787

# Shared secret used to sign outbound webhooks and verify inbound ones
APPROVALS_WEBHOOK_SECRET=change-me

# Optional: deliver a signed webhook here whenever a decision changes
# (e.g. an endpoint that wakes the waiting agent)
APPROVALS_WEBHOOK_URL=

# Postgres connection for the db package and the reviewer app.
# Leave empty to run against the in-memory store (local/demo only).
DATABASE_URL=

# Optional: post approved messages to a real Slack incoming webhook.
# Without it, the demo executor logs the message instead of sending it.
SLACK_WEBHOOK_URL=
